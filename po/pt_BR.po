#: ../src/celestia/qt/preferences.ui:1286
msgid ""
"Soft-clip on per-star irradiance. 0 = disabled.\n"
"Valid range: 1.0 to 1.0e6."
msgstr ""
"Corte suave da irradiância por estrela. 0 = desativado.\n"
"Faixa válida: 1.0 a 1.0e6."

#. ectx: property (text), widget (QLabel, psfDimClipFactorLabel)
#: ../src/celestia/qt/preferences.ui:1313
msgid "Dim star clipping:"
msgstr "Corte de estrelas fracas:"

#. ectx: property (toolTip), widget (QDoubleSpinBox, psfDimClipFactorSpinBox)
#: ../src/celestia/qt/preferences.ui:1320
msgid ""
"Hyperbolic soft-clip on dim stars; higher values cull more dim stars for "
"performance.\n"
"Valid range: 1.0 to 100.0."
msgstr ""
"Corte suave hiperbólico de estrelas fracas; valores maiores eliminam mais "
"estrelas para melhor desempenho.\n"
"Faixa válida: 1.0 a 100.0."

#. ectx: property (toolTip), widget (QDoubleSpinBox, psfExposureSpinBox)
